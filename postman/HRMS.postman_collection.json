{
  "info": {
    "name": "HRMS Attendance API (Local)",
    "_postman_id": "hrms-attendance-local-collection",
    "description": "Local endpoints for the Go/Fiber HRMS Attendance service (cmd/server/main.go). Run with `go run ./cmd/server` (defaults to port 8080) after setting DB_HOST, DB_PORT, DB_USER, DB_PASSWORD, DB_NAME (or DATABASE_URL).\n\nIMPORTANT: employeeId / leaveTypeId / approvedBy / rejectedBy / approverId are Postgres UUID columns and MUST be valid UUID strings, not free-text codes like EMP001. Replace the sample UUIDs with real ones from your database.\n\nNote on response casing: handwritten response DTOs (ClockInResult, ClockOutResult, SalaryCalculation) use camelCase JSON keys. Endpoints that return raw db_gen model structs (Attendance, Regularization, LeaveType, LeaveApplication, EmployeeLeaveBalance, LeaveApproval, LeavePolicy) have NO json tags, so Go's encoding/json falls back to the exported Go field names — those responses come back PascalCase (ID, EmployeeId, CreatedAt, ...).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "employeeId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "attendanceId", "value": "1" },
    { "key": "regularizationId", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "leaveTypeId", "value": "33333333-3333-3333-3333-333333333333" },
    { "key": "leaveApplicationId", "value": "44444444-4444-4444-4444-444444444444" },
    { "key": "policyId", "value": "55555555-5555-5555-5555-555555555555" },
    { "key": "managerId", "value": "66666666-6666-6666-6666-666666666666" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "method": "GET",
            "url": { "raw": "{{baseUrl}}/health", "host": ["{{baseUrl}}"], "path": ["health"] }
          },
          "response": [
            {
              "name": "OK (plain text, not JSON)",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "text/plain; charset=utf-8" }],
              "body": "HRMS Attendance Service is running perfectly!"
            }
          ]
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Clock In",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": \"{{employeeId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/attendance/clock-in", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "clock-in"] }
          },
          "response": [
            {
              "name": "201 Created",
              "status": "Created",
              "code": 201,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"employeeId\": \"11111111-1111-1111-1111-111111111111\",\n  \"inTime\": \"2026-09-22T09:15:00Z\",\n  \"message\": \"Successfully clocked in\",\n  \"lateBy\": \"15m\"\n}"
            },
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"employeeId is required\"\n}"
            }
          ]
        },
        {
          "name": "Clock Out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"employeeId\": \"{{employeeId}}\"\n}" },
            "url": { "raw": "{{baseUrl}}/api/attendance/clock-out", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "clock-out"] }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"employeeId\": \"11111111-1111-1111-1111-111111111111\",\n  \"outTime\": \"2026-09-22T18:05:00Z\",\n  \"totalWorkHours\": \"8h50m\",\n  \"message\": \"Successfully clocked out\"\n}"
            },
            {
              "name": "400 Bad Request",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"employeeId is required\"\n}"
            }
          ]
        },
        {
          "name": "Import Attendance (Excel)",
          "request": {
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": [], "description": "Excel (.xlsx) file, form field name MUST be 'file'" }
              ]
            },
            "url": { "raw": "{{baseUrl}}/api/attendance/import", "host": ["{{baseUrl}}"], "path": ["api", "attendance", "import"] }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"message\": \"Attendance Excel import completed\",\n  \"totalRows\": 10,\n  \"successRows\": 9,\n  \"failedRows\": 1,\n  \"errors\": [\"row 6: invalid date format\"]\n}"
            },
            {
              "name": "400 Bad Request (missing file)",
              "status": "Bad Request",
              "code": 400,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"error\": \"Excel file is required\"\n}"
            }
          ]
        },
        {
          "name": "Get Employee Attendance",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/attendance/{{employeeId}}?fromDate=2026-09-01&toDate=2026-09-22",
              "host": ["{{baseUrl}}"],
              "path": ["api", "attendance", "{{employeeId}}"],
              "query": [
                { "key": "fromDate", "value": "2026-09-01" },
                { "key": "toDate", "value": "2026-09-22" }
              ]
            }
          },
          "response": [
            {
              "name": "200 OK",
              "status": "OK",
              "code": 200,
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "body": "{\n  \"employeeId\": \"11111111-1111-1111-1111-111111111111\",\n  \"fromDate\": \"2026-09-01\",\n  \"toDate\": \"2026-09-22\",\n  \"attendance\": [\n    {\n      \"ID\": 1,\n      \"EmployeeId\": \"11111111-1111-1111-1111-111111111111\",\n      \"Date\": \"2026-09-22T00:00:00Z\",\n      \"CheckInTime\": \"2026-09-22T09:15:00Z\",\n      \"CheckOutTime\": \"2026-09-22T18:05:00Z\",\n      \"Status\": \"Present\",\n      \"WorkHours\": \"8.83\",\n      \"Remarks\": null,\n      \"CreatedAt\": \"2026-09-22T09:15:00Z\",\n      \"UpdatedAt\": \"2026-09-22T18:05:00Z\",\n      \"MarkedBy\": null\n    }\n  ]\n}"
